# ==========================================
# 环境变量（如有敏感信息）
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# WebStorm / JetBrains IDE 配置（按需提交）
# ==========================================
.idea/
# ✅ 保留：运行配置、代码检查规则、代码风格（方便个人多设备同步或团队共享）
!.idea/runConfigurations/
!.idea/inspectionProfiles/
!.idea/codeStyles/
!.idea/*.xml

# ❌ 忽略：本地窗口状态、缓存、用户私有数据（每台电脑/每次打开都会不同）
.idea/workspace.xml
.idea/*.iws
.idea/caches/
.idea/shelf/
.idea/tasks/
.idea/dictionaries/
.idea/dataSources/
.idea/usage.statistics.xml

# ==========================================
# 操作系统与编辑器临时文件
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ==========================================
# 日志与调试
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log